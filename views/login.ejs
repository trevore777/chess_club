<!DOCTYPE html>
<html><head><title>Live Chess Login</title><link rel="stylesheet" href="/css/styles.css"></head>
<body><nav><strong>Chess Club Live Play</strong></nav>
<main class="container"><section class="card login-card">
<h1>Student Login</h1><p>Students log in to play live turn-based chess.</p>
<% if (error) { %><div class="error"><%= error %></div><% } %>
<form method="POST" action="/login">
<input name="username" placeholder="Username" required>
<input name="password" type="password" placeholder="Password" required>
<button type="submit">Login</button>
</form>
<p class="small-muted">Demo: sam/password123, alex/password123, mia/password123, noah/password123</p>
</section></main></body></html>
