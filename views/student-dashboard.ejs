<!DOCTYPE html>
<html><head><title>Student Chess Club</title><link rel="stylesheet" href="/css/styles.css"></head><body>
<nav><strong>Chess Club</strong><a href="/student">Student</a><a href="/leaderboard">Leaderboard</a><a href="/show" target="_blank">Show Screen</a><a href="/logout">Logout</a></nav>
<main class="container">
<section class="page-header"><h1>Students Chess Club</h1><p>Welcome, <%= currentUser.name %>. Your ranking and competition games appear below.</p></section>
<section class="card profile-card"><h2>My Ranking</h2><div class="grid four"><div class="stat"><span>Points</span><strong><%= currentUser.points || 0 %></strong></div><div class="stat"><span>Wins</span><strong><%= currentUser.wins || 0 %></strong></div><div class="stat"><span>Draws</span><strong><%= currentUser.draws || 0 %></strong></div><div class="stat"><span>Rating</span><strong><%= currentUser.rating || 1200 %></strong></div></div></section>
<section class="card"><h2>My Games</h2>
<% if (!matches || !matches.length) { %><p>No games have been assigned yet.</p><% } else { %>
<table><thead><tr><th>Competition</th><th>Round</th><th>Board</th><th>White</th><th>Black</th><th>Result</th><th>Board</th></tr></thead><tbody>
<% matches.forEach(m => { %><tr><td><%= m.competition_name %></td><td><%= m.round_number %></td><td><%= m.board_number %></td><td><%= m.white_name || 'BYE' %></td><td><%= m.black_name || 'BYE' %></td><td><%= m.result %></td><td><a href="/show/board/<%= m.id %>" target="_blank">View</a></td></tr><% }) %>
</tbody></table><% } %></section>
<section class="card"><h2>Club Leaderboard</h2><table><thead><tr><th>Rank</th><th>Student</th><th>Points</th><th>W</th><th>D</th><th>L</th><th>Rating</th></tr></thead><tbody><% leaderboard.forEach((p, i) => { %><tr><td><%= i + 1 %></td><td><%= p.name %></td><td><%= p.points %></td><td><%= p.wins %></td><td><%= p.draws %></td><td><%= p.losses %></td><td><%= p.rating %></td></tr><% }) %></tbody></table></section>
</main></body></html>
