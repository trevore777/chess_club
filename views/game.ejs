<!DOCTYPE html>
<html><head><title>Live Game</title><link rel="stylesheet" href="/css/styles.css"></head>
<body data-game-id="<%= game.id %>" data-user-id="<%= currentUser.id %>" data-fen="<%= game.fen %>" data-status="<%= game.status %>">
<nav><strong>Chess Club Live Play</strong><a href="/lobby?user=<%= currentUser.id %>">Lobby</a><a href="/logout">Logout</a></nav>
<main class="container"><h1><%= game.white_name %> vs <%= game.black_name %></h1>
<section class="card"><div class="status-box">You are: <strong><%= currentUser.id === game.white_player_id ? "White" : "Black" %></strong> · Turn: <strong><%= game.turn === "w" ? "White" : "Black" %></strong> · Result: <strong><%= game.result %></strong></div>
<div class="board-layout"><div><div class="board-shell">
<div class="rank-labels"><span>8</span><span>7</span><span>6</span><span>5</span><span>4</span><span>3</span><span>2</span><span>1</span></div>
<div class="board-fixed" data-board>
<% squares.forEach(square => { %><div class="board-square <%= square.color %>" data-square="<%= square.id %>"><%= square.piece || "" %></div><% }) %>
</div><div></div><div class="file-labels"><span>a</span><span>b</span><span>c</span><span>d</span><span>e</span><span>f</span><span>g</span><span>h</span></div>
</div></div><aside><h2>Move History</h2>
<% if (!moves.length) { %><p>No moves yet.</p><% } else { %><ol class="move-list"><% moves.forEach(m => { %><li><%= m.san || (m.from_square + " → " + m.to_square) %></li><% }) %></ol><% } %>
</aside></div></section></main><script src="/js/game.js"></script></body></html>
