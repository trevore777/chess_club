<!DOCTYPE html>
<html><head><title>Board Control</title><link rel="stylesheet" href="/css/styles.css"></head><body>
<nav><strong>Chess Club</strong><a href="/coach">Coach</a><a href="/show/board/<%= match.id %>" target="_blank">Open Display Board</a><a href="/logout">Logout</a></nav>
<main class="container board-page">
<section class="page-header"><h1>Board Control</h1><p><%= match.competition_name %> — Board <%= match.board_number %>: <strong><%= match.white_name || 'BYE' %></strong> vs <strong><%= match.black_name || 'BYE' %></strong></p></section>
<section class="card"><p class="small-muted">Drag pieces manually as the game is played. This does not enforce legal chess moves; it is for display only.</p><div id="board" class="chessboard" data-fen="<%= board.fen %>"></div><form method="POST" action="/matches/<%= match.id %>/board" class="inline-form board-save"><input type="hidden" id="fen" name="fen" value="<%= board.fen %>"><button>Save Board Position</button></form><form method="POST" action="/matches/<%= match.id %>/board/reset" class="inline-form"><button class="secondary">Reset Board</button></form></section>
</main>
<script src="/js/board.js"></script>
</body></html>
