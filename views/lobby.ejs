<!DOCTYPE html>
<html><head><title>Chess Lobby</title><link rel="stylesheet" href="/css/styles.css"></head>
<body><nav><strong>Chess Club Live Play</strong><a href="/lobby?user=<%= currentUser.id %>">Lobby</a><a href="/logout">Logout</a></nav>
<main class="container">
<h1>Welcome, <%= currentUser.name %></h1>
<section class="card"><h2>Start a Game</h2>
<form method="POST" action="/games">
<input type="hidden" name="white_player_id" value="<%= currentUser.id %>">
<select name="black_player_id" required><option value="">Choose opponent</option>
<% players.filter(p => p.id !== currentUser.id).forEach(p => { %>
<option value="<%= p.id %>"><%= p.name %> (<%= p.rating || 1200 %>)</option>
<% }) %></select><button type="submit">Create Game</button></form></section>
<section class="grid two">
<div class="card"><h2>My Active Games</h2>
<% if (!myGames.length) { %><p>No active games.</p><% } else { %>
<table><thead><tr><th>Game</th><th>Turn</th><th>Open</th></tr></thead><tbody>
<% myGames.forEach(g => { %><tr><td><%= g.white_name %> vs <%= g.black_name %></td><td><%= g.turn === "w" ? "White" : "Black" %></td><td><a class="button" href="/games/<%= g.id %>?user=<%= currentUser.id %>">Play</a></td></tr><% }) %>
</tbody></table><% } %></div>
<div class="card"><h2>Leaderboard</h2><table><thead><tr><th>Rank</th><th>Name</th><th>Pts</th><th>Rating</th></tr></thead><tbody>
<% players.forEach((p, index) => { %><tr><td><%= index + 1 %></td><td><%= p.name %></td><td><%= p.points || 0 %></td><td><%= p.rating || 1200 %></td></tr><% }) %>
</tbody></table></div></section></main></body></html>
