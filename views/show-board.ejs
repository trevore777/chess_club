<!DOCTYPE html>
<html>
<head>
  <title>Chess Club Feature Game</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="show-screen">
<main class="container">
  <section class="page-header">
    <h1>Chess Club Feature Game</h1>
    <% if (match) { %>
      <p><%= match.competition_name %> · Round <%= match.round_number %> · Board <%= match.board_number %></p>
      <p class="versus">
        White: <strong><%= match.white_name || 'BYE' %></strong><br>
        Black: <strong><%= match.black_name || 'BYE' %></strong>
      </p>
      <p>Result: <%= match.result || "pending" %></p>
    <% } %>
  </section>

  <section class="card show-layout">
    <div>
      <div class="board-shell">
        <div class="rank-labels">
          <span>8</span><span>7</span><span>6</span><span>5</span>
          <span>4</span><span>3</span><span>2</span><span>1</span>
        </div>

        <div class="board-fixed" data-board>
          <% (squares || []).forEach(square => { %>
            <div class="board-square <%= square.color %>" data-square="<%= square.id %>"><%= square.piece || "" %></div>
          <% }) %>
        </div>

        <div></div>

        <div class="file-labels">
          <span>a</span><span>b</span><span>c</span><span>d</span>
          <span>e</span><span>f</span><span>g</span><span>h</span>
        </div>
      </div>
    </div>

    <aside class="move-panel">
      <h2>Move History</h2>
      <% if (!moves || !moves.length) { %>
        <p class="small-muted">No moves recorded yet.</p>
      <% } else { %>
        <ol class="move-list">
  <% moves.forEach(m => { %>
    <li data-fen-after="<%= m.fen_after %>">
      <%= m.piece %> <%= m.from_square %> → <%= m.to_square %>
    </li>
  <% }) %>
</ol>

        <div class="replay-controls">
          <button type="button">Start</button>
          <button type="button">Previous</button>
          <button type="button">Next</button>
          <button type="button">Latest</button>
        </div>
      <% } %>
    </aside>
  </section>
</main>
</body>
</html>
