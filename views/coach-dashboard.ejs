<!DOCTYPE html>
<html>
<head>
  <title>Coach Dashboard</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav>
  <strong>Chess Club</strong>
  <a href="/coach">Coach</a>
  <a href="/players">Players</a>
  <a href="/leaderboard">Leaderboard</a>
  <a href="/show" target="_blank">Show Screen</a>
  <a href="/logout">Logout</a>
</nav>

<main class="container">
  <section class="page-header">
    <h1>Coach Page</h1>
    <p>Manage players, generate competitions, enter results, select a show-screen game, and control the display board.</p>
  </section>

  <% if (typeof message !== "undefined" && message) { %>
    <section class="card"><p><strong><%= message %></strong></p></section>
  <% } %>

  <section class="grid three">
    <div class="card stat"><span>Students</span><strong><%= students?.count || 0 %></strong></div>
    <div class="card stat"><span>Competitions</span><strong><%= comps?.count || 0 %></strong></div>
    <div class="card stat"><span>Active</span><strong><%= active?.count || 0 %></strong></div>
  </section>

  <section class="card">
    <h2>Current Show Screen Game</h2>
    <% if (featured) { %>
      <p><strong><%= featured.competition_name %></strong> — Round <%= featured.round_number %>, Board <%= featured.board_number %></p>
      <p class="versus"><%= featured.white_name || "BYE" %> vs <%= featured.black_name || "BYE" %></p>
      <a class="button" href="/show" target="_blank">Open Show Screen</a>
      <a class="button secondary" href="/matches/<%= featured.id %>/board">Control Board</a>
    <% } else { %>
      <p>No game has been selected for the show screen yet.</p>
    <% } %>
  </section>

  <section class="card">
    <h2>Create Competition</h2>
    <p>Round 1 players are paired using the current leaderboard order.</p>
    <form method="POST" action="/competitions" class="inline-form">
      <input type="text" name="name" placeholder="Competition name" required>
      <button type="submit">Create Round 1</button>
    </form>
  </section>

  <section class="card">
    <h2>Generate Next Round</h2>
    <% if (!competitions || !competitions.length) { %>
      <p>No competitions yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Competition</th>
            <th>Status</th>
            <th>Latest Round</th>
            <th>Pending</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% competitions.forEach(c => { %>
            <tr>
              <td><%= c.name %></td>
              <td><%= c.status || "active" %></td>
              <td><%= c.latest_round || 0 %></td>
              <td><%= c.pending_matches || 0 %></td>
              <td>
                <form method="POST" action="/competitions/<%= c.id %>/next-round">
                  <button type="submit">Generate Next Round</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section class="card">
    <h2>Leaderboard</h2>
    <% if (!leaderboard || !leaderboard.length) { %>
      <p>No students found.</p>
    <% } else { %>
      <table>
        <thead>
          <tr><th>Rank</th><th>Student</th><th>Pts</th><th>W</th><th>D</th><th>L</th><th>Rating</th></tr>
        </thead>
        <tbody>
          <% leaderboard.forEach((p, index) => { %>
            <tr>
              <td><strong><%= index + 1 %></strong></td>
              <td><%= p.name %></td>
              <td><%= p.points || 0 %></td>
              <td><%= p.wins || 0 %></td>
              <td><%= p.draws || 0 %></td>
              <td><%= p.losses || 0 %></td>
              <td><%= p.rating || 1200 %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section class="card">
    <h2>Recent Matches</h2>
    <% if (!recentMatches || !recentMatches.length) { %>
      <p>No matches yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr><th>Competition</th><th>Round</th><th>Board</th><th>Game</th><th>Result</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% recentMatches.forEach(m => { %>
            <tr>
              <td><%= m.competition_name %></td>
              <td><%= m.round_number %></td>
              <td><%= m.board_number %></td>
              <td><%= m.white_name || "BYE" %> vs <%= m.black_name || "BYE" %></td>
              <td><%= m.result || "pending" %></td>
              <td>
                <form method="POST" action="/matches/<%= m.id %>/result">
                  <select name="result">
                    <option value="pending" <%= m.result === "pending" ? "selected" : "" %>>Pending</option>
                    <option value="white_win" <%= m.result === "white_win" ? "selected" : "" %>>White win</option>
                    <option value="black_win" <%= m.result === "black_win" ? "selected" : "" %>>Black win</option>
                    <option value="draw" <%= m.result === "draw" ? "selected" : "" %>>Draw</option>
                  </select>
                  <button type="submit">Save</button>
                </form>
                <form method="POST" action="/matches/<%= m.id %>/feature"><button type="submit">Show</button></form>
                <a class="button secondary" href="/matches/<%= m.id %>/board">Board</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</main>
</body>
</html>
