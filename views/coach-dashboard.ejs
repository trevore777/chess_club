<!DOCTYPE html>
<html><head><title>Coach Page</title><link rel="stylesheet" href="/css/styles.css"></head><body>
<nav><strong>Chess Club</strong><a href="/coach">Coach</a><a href="/players">Players</a><a href="/leaderboard">Leaderboard</a><a href="/show" target="_blank">Show Screen</a><a href="/logout">Logout</a></nav>
<main class="container">
<section class="page-header"><h1>Coach Page</h1><p>Manage players, generate competitions, enter results, select a show-screen game, and control the display board.</p></section>
<div class="grid three"><div class="stat card"><span>Students</span><strong><%= students.count %></strong></div><div class="stat card"><span>Competitions</span><strong><%= comps.count %></strong></div><div class="stat card"><span>Active</span><strong><%= active.count %></strong></div></div>
<section class="card"><h2>Current Show Screen Game</h2><% if (featured) { %><p><strong><%= featured.competition_name %></strong> — Round <%= featured.round_number %>, Board <%= featured.board_number %></p><p class="versus"><%= featured.white_name || 'BYE' %> vs <%= featured.black_name || 'BYE' %></p><a class="button secondary" href="/show" target="_blank">Open Show Screen</a> <a class="button" href="/matches/<%= featured.id %>/board">Control Board</a><% } else { %><p>No game has been selected for the show screen yet.</p><% } %></section>
<section class="card"><h2>Create Competition</h2><p class="small-muted">Players are paired using the current leaderboard order.</p><form method="POST" action="/competitions/create" class="inline-form"><input name="name" placeholder="Competition name"><button>Create Round 1</button></form></section>
<section class="card"><h2>Leaderboard</h2><table><thead><tr><th>Rank</th><th>Student</th><th>Pts</th><th>W</th><th>D</th><th>L</th><th>Rating</th></tr></thead><tbody><% leaderboard.forEach((p, i) => { %><tr><td><%= i + 1 %></td><td><%= p.name %></td><td><%= p.points %></td><td><%= p.wins %></td><td><%= p.draws %></td><td><%= p.losses %></td><td><%= p.rating %></td></tr><% }) %></tbody></table></section>
<section class="card"><h2>Recent Matches</h2><% if (!recentMatches.length) { %><p>No matches yet. Create a competition first.</p><% } else { %><table><thead><tr><th>Competition</th><th>Board</th><th>Game</th><th>Result</th><th>Actions</th></tr></thead><tbody><% recentMatches.forEach(m => { %><tr><td><%= m.competition_name %></td><td><%= m.board_number %></td><td><%= m.white_name || 'BYE' %> vs <%= m.black_name || 'BYE' %></td><td><%= m.result %></td><td><form method="POST" action="/matches/<%= m.id %>/result" class="table-form"><select name="result"><option value="pending" <%= m.result === 'pending' ? 'selected' : '' %>>Pending</option><option value="white_win" <%= m.result === 'white_win' ? 'selected' : '' %>>White win</option><option value="black_win" <%= m.result === 'black_win' ? 'selected' : '' %>>Black win</option><option value="draw" <%= m.result === 'draw' ? 'selected' : '' %>>Draw</option></select><button>Save</button></form><form method="POST" action="/matches/<%= m.id %>/feature" class="table-form"><button class="secondary">Show</button></form><a class="button small" href="/matches/<%= m.id %>/board">Board</a></td></tr><% }) %></tbody></table><% } %></section>
</main></body></html>
